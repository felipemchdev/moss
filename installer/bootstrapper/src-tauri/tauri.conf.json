{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moss-installer",
  "mainBinaryName": "moss-installer",
  "version": "1.0.0",
  "identifier": "dev.moss.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "bootstrapper",
        "title": "moss installer",
        "width": 480,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0F1411"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
