{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Browser chrome only; tab webviews load remote content and get no IPC access.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-set-viewport",
    "allow-navigate-to",
    "allow-reload-page",
    "allow-go-back",
    "allow-go-forward",
    "allow-show-tab",
    "allow-close-tab"
  ]
}
