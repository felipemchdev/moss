{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Browser chrome only; tab webviews load remote content and get no IPC access.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-set-viewport",
    "allow-navigate-to",
    "allow-reload-page",
    "allow-go-back",
    "allow-go-forward",
    "allow-show-tab",
    "allow-close-tab",
    "allow-minimize-window",
    "allow-toggle-maximize-window",
    "allow-close-window",
    "allow-set-privacy-shield",
    "allow-sync-tab-trackers-blocked",
    "allow-reset-trackers-count",
    "allow-export-data-file"
  ]
}
