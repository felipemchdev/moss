{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Browser chrome only; tab webviews load remote content and get no IPC access.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-set-viewport",
    "allow-set-tab-viewports",
    "allow-navigate-to",
    "allow-reload-page",
    "allow-go-back",
    "allow-go-forward",
    "allow-show-tab",
    "allow-show-tabs",
    "allow-close-tab",
    "allow-minimize-window",
    "allow-toggle-maximize-window",
    "allow-close-window",
    "allow-set-privacy-shield",
    "allow-sync-tab-trackers-blocked",
    "allow-reset-trackers-count",
    "allow-export-data-file",
    "allow-find-in-page",
    "allow-clear-find-in-page",
    "allow-extract-reader-content",
    "allow-set-tab-zoom",
    "allow-clear-tab-data",
    "allow-set-site-permission",
    "allow-sync-site-permissions",
    "allow-reset-site-permissions",
    "allow-apply-tab-boost",
    "allow-start-element-zapper",
    "allow-set-tab-muted",
    "allow-toggle-tab-media-playback",
    "allow-sync-tab-media-state"
  ]
}
